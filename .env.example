# Flask backend
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
DATABASE_URL=sqlite:///complaints.db
FRONTEND_URL=http://localhost:5173
HOST=127.0.0.1
PORT=5000
COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# Optional Google OAuth; keep credentials server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact callback URL in Google Cloud:
# http://localhost:5000/api/v1/auth/google/callback
# In Docker Compose, register http://localhost:8080/api/v1/auth/google/callback.

# Optional external resolution generation. The user must opt in per complaint.
GEMINI_API_KEY=
ENABLE_GEMINI=false
ENABLE_LLM=false
GEMINI_MODEL_NAME=gemini-2.5-flash

# Local database backup files
BACKUP_DIR=instance/backups

# PostgreSQL Docker Compose profile (set POSTGRES_PASSWORD before `docker compose up`)
POSTGRES_DB=campuscare
POSTGRES_USER=campuscare
POSTGRES_PASSWORD=replace-with-a-strong-random-password
