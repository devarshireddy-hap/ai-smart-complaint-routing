# Local Docker Compose settings. Copy this file to .env; never commit .env.
# Use a URL-safe database password (letters and numbers) for DATABASE_URL.
DB_USER=postgres
DB_PASSWORD=change-this-to-a-long-url-safe-password
DB_NAME=complaint_routing
DB_PORT=5432

# Local-only defaults. Generate distinct random values before deployment.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_SECRET_KEY=replace-with-a-different-random-secret-at-least-32-characters
COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional Google OAuth. Leave both blank to use email/password authentication.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI in Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Optional Gemini integration. It remains disabled unless explicitly enabled.
ENABLE_GEMINI=false
GEMINI_API_KEY=

# Used when running the API or ingestion scripts directly on the host.
DATABASE_URL=postgresql+psycopg2://postgres:change-this-to-a-long-url-safe-password@localhost:5432/complaint_routing
