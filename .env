# Frontend environment configuration.
# These are the ONLY values the frontend needs. No API keys, client secrets,
# or database credentials belong here — those live only in the backend's own
# .env (Milan/Devarshi's backend .env.example), never in this app.

# Base URL of the Flask API. In local dev this can stay empty because Vite
# proxies /api/v1 and /auth to VITE_DEV_BACKEND_ORIGIN below. In production
# or Docker, point it at the deployed backend origin, e.g. https://api.example.edu
VITE_API_BASE_URL=

# Backend origin used ONLY by the Vite dev server proxy. Not read by
# application code and never bundled into the browser build.
VITE_DEV_BACKEND_ORIGIN=http://localhost:5000

# PRACTICE MODE -- set to "true" to preview every dashboard with fake data
# and no backend at all. See docs/PRACTICE_MODE_GUIDE.md. Leave as "false"
# (or delete this line) once the real backend is ready, and always leave
# it false/unset for any real deployment.
VITE_MOCK_MODE=false
